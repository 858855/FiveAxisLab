; Virtual MCU fixture only; not machine startup instructions.
SET_KINEMATIC_POSITION X=10 Y=0 Z=10
G90
M83
MANUAL_STEPPER STEPPER=rotary_a GCODE_AXIS=A LIMIT_VELOCITY=30 LIMIT_ACCEL=60
MANUAL_STEPPER STEPPER=rotary_b GCODE_AXIS=C LIMIT_VELOCITY=30 LIMIT_ACCEL=60
SET_PRESSURE_ADVANCE ADVANCE=0
G1 X10 Y1 Z10 A10 C10 E0.05 F300
; Genuine deposition from bed rotation with unchanged XYZ.
G1 X10 Y1 Z10 A10 C20 E0.05 F300
G1 X10 Y1 Z10 A10 C30 E0.05 F300
G1 X15 Y1 Z12 A15 C35 E0.05 F300
G1 E-0.1 F60
M400
